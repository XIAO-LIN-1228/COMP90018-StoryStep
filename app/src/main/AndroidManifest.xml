<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Foreground-only location. ACCESS_BACKGROUND_LOCATION is deliberately absent and must not
        be added: continuous background tracking is out of scope for this project.
        Coarse is requested alongside fine so a user who grants approximate-only access still
        gets discovery, with route precision and automatic arrival disabled.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Brief confirmation after a persisted arrival; no runtime prompt is required. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Weather is fetched on demand while the app is in the foreground: on opening a screen that
        shows it, and then only when the cached observation for the area has expired. There is no
        background sync, no polling and no upload — nothing leaves the device except a request for
        the weather at the centre of a coarse grid cell, never the user's own coordinates.
        ACCESS_NETWORK_STATE only lets the app say "offline" instead of a generic failure.
    -->
    <!-- The step counter is behind this from API 29; without it the walk simply has no steps. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Every sensing capability is optional. The app degrades to what a device actually has:
        no accelerometer means no movement estimate, no compass means bearing-and-distance
        guidance without an arrow, and neither stops an exploration session from recording.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.barometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Required for discovering installed TTS engines on Android 11 and newer. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".StoryStepApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StoryStep">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Hands the camera a writable URI for one file in the walk's photo directory, so a
            picture taken on the walk lands where the walk's other photographs live.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
