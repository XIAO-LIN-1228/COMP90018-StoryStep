<?xml version="1.0" encoding="utf-8"?>
<!-- A walk as a rounded photograph tile with its name and date over a soft scrim at the foot. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_walk_card"
    android:layout_width="200dp"
    android:layout_height="150dp"
    android:layout_marginEnd="@dimen/space_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/story_surface_sunk"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <ImageView
        android:id="@+id/profile_walk_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_tile_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/profile_walk_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/bricolage_semibold"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/profile_walk_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/bricolage"
            android:maxLines="1"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
