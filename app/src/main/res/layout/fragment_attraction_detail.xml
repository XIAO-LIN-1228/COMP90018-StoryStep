<?xml version="1.0" encoding="utf-8"?>
<!--
    Detail in the reference's order: the photograph runs to the edges at the top and carries
    its own chrome on a scrim; the name, facts and prose follow on the paper beneath it. When
    the source has no photograph the hero collapses and the page opens on the name instead.
    Actions live in a capsule floating clear of the content.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground">

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hero_photo_height"
                    android:background="@drawable/bg_thumb_placeholder"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_old_arts" />

                <ImageButton
                    android:id="@+id/detail_back_button"
                    style="@style/Widget.StoryStep.ScrimButton"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="@dimen/page_horizontal_margin"
                    android:layout_marginTop="@dimen/space_16"
                    android:contentDescription="@string/detail_back"
                    android:src="@drawable/ic_back" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_horizontal_margin"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/page_horizontal_margin">

                <!-- Where the photograph came from; only shown when one was fetched. -->
                <TextView
                    android:id="@+id/detail_photo_credit"
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:text="@string/detail_photo_credit"
                    android:textColor="@color/story_ink_3"
                    android:textSize="@dimen/text_label"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detail_name"
                    style="@style/TextAppearance.StoryStep.PageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/detail_category"
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="6dp"
                    android:textColor="@color/story_ink_3"
                    app:drawableStartCompat="@drawable/ic_location_outline"
                    app:drawableTint="@color/story_ink_3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detail_venue_type"
                        style="@style/Widget.StoryStep.Pill" />

                    <TextView
                        style="@style/Widget.StoryStep.Pill"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/detail_pill_locked"
                        android:textColor="@color/story_signal_ink"
                        app:drawableStartCompat="@drawable/ic_spark"
                        app:drawableTint="@color/story_signal_ink" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.StoryStep.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:text="@string/detail_about" />

                <TextView
                    android:id="@+id/detail_description"
                    style="@style/TextAppearance.StoryStep.Prose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12" />

                <!--
                    What a visitor needs before going: hours, contact, access, entry. Absent
                    for most places, so the whole block goes when there is nothing in it.
                -->
                <TextView
                    android:id="@+id/detail_facts_heading"
                    style="@style/TextAppearance.StoryStep.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:text="@string/detail_good_to_know"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/detail_facts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginBottom="@dimen/space_24"
                    android:background="@drawable/bg_inset_note"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_spark"
                        app:tint="@color/story_signal_ink" />

                    <TextView
                        style="@style/TextAppearance.StoryStep.Supporting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:text="@string/detail_story_locked" />
                </LinearLayout>

                <!--
                    Where the place data came from. OpenStreetMap's licence requires it on
                    screen; at the foot, small and quiet, it is credited without competing
                    with the place it credits.
                -->
                <TextView
                    android:id="@+id/detail_attribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    android:fontFamily="@font/bricolage"
                    android:textColor="@color/story_ink_3"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        style="@style/Widget.StoryStep.Card.Raised"
        android:layout_width="0dp"
        android:layout_height="@dimen/floating_bar_height"
        android:layout_marginStart="@dimen/page_horizontal_margin"
        android:layout_marginEnd="@dimen/page_horizontal_margin"
        android:layout_marginBottom="@dimen/space_24"
        android:background="@drawable/bg_floating_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/detail_save_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_save"
            android:padding="13dp"
            android:src="@drawable/ic_bookmark_outline"
            app:tint="@color/story_ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_start_button"
            style="@style/Widget.StoryStep.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="50dp"
            android:text="@string/detail_add_to_walk" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
