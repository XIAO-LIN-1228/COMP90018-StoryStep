<?xml version="1.0" encoding="utf-8"?>
<!--
    Detail follows the story anatomy: full-bleed photograph carrying its own chrome,
    a content column at the page margin, and the ink action fixed at the foot so the
    decision to walk there is always reachable without scrolling back.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground">

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/detail_start_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_photo_height">

                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_old_arts" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim" />

                <ImageButton
                    android:id="@+id/detail_back_button"
                    style="@style/Widget.StoryStep.ScrimButton"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="@dimen/page_horizontal_margin"
                    android:layout_marginTop="@dimen/space_24"
                    android:contentDescription="@string/detail_back"
                    android:src="@drawable/ic_back" />

                <ImageButton
                    android:id="@+id/detail_save_button"
                    style="@style/Widget.StoryStep.ScrimButton"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/page_horizontal_margin"
                    android:contentDescription="@string/detail_save"
                    android:src="@drawable/ic_bookmark_outline" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_horizontal_margin"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/page_horizontal_margin"
                android:paddingBottom="@dimen/space_24">

                <!-- Category and venue type read as annotation on the name, not as prose. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detail_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.StoryStep.Label" />

                    <TextView
                        android:id="@+id/detail_venue_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.StoryStep.Label" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_name"
                    style="@style/TextAppearance.StoryStep.PageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" />

                <TextView
                    android:id="@+id/detail_description"
                    style="@style/TextAppearance.StoryStep.Prose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16" />

                <View
                    style="@style/Widget.StoryStep.Divider"
                    android:layout_marginTop="@dimen/space_24" />

                <!--
                    The story is deliberately withheld until arrival: saying so here is what
                    makes the walk the point rather than a delay before the same paragraph.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_inset_note"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock_outline"
                        app:tint="@color/story_signal_ink" />

                    <TextView
                        style="@style/TextAppearance.StoryStep.Supporting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:text="@string/detail_story_locked" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/detail_start_button"
        style="@style/Widget.StoryStep.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/primary_button_height"
        android:layout_marginStart="@dimen/page_horizontal_margin"
        android:layout_marginEnd="@dimen/page_horizontal_margin"
        android:layout_marginBottom="@dimen/space_24"
        android:text="@string/detail_start_exploration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
