<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory">

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/detail_start_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_old_arts" />

                <ImageButton
                    android:id="@+id/detail_back_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|top"
                    android:layout_margin="12dp"
                    android:background="@color/white"
                    android:contentDescription="@string/detail_back"
                    android:padding="12dp"
                    android:src="@drawable/ic_back" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_save_button"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|top"
                    android:layout_margin="12dp"
                    android:contentDescription="@string/detail_save"
                    android:minWidth="48dp"
                    android:text="@string/icon_save"
                    android:textSize="24sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_24">

                <TextView
                    android:id="@+id/detail_name"
                    style="@style/TextAppearance.StoryStep.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Old Arts Building" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/detail_category"
                        style="@style/Widget.StoryStep.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        tools:text="Heritage" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/detail_venue_type"
                        style="@style/Widget.StoryStep.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        tools:text="Outdoor" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    style="@style/TextAppearance.StoryStep.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/detail_distance_demo"
                    android:textColor="@color/brand_teal"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.StoryStep.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/detail_why_visit" />

                <TextView
                    android:id="@+id/detail_description"
                    style="@style/TextAppearance.StoryStep.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    tools:text="A landmark of Gothic Revival architecture and university history." />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.StoryStep.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/story_surface_muted">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="84dp"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_soft_teal"
                            android:gravity="center"
                            android:text="@string/icon_lock"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.StoryStep.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_locked_story"
                                android:textColor="@color/story_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextAppearance.StoryStep.Supporting"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/detail_locked_supporting" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/detail_start_button"
        style="@style/Widget.StoryStep.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/primary_button_height"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_12"
        android:text="@string/detail_start_exploration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
