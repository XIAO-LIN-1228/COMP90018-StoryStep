<?xml version="1.0" encoding="utf-8"?>
<!--
    When to leave: the stay time on top, then a summary of the best departure, then every
    departure over the next day with its chance of rain during the walk.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/page_horizontal_margin">

        <ImageButton
            android:id="@+id/advice_back"
            style="@style/Widget.StoryStep.ScrimButton"
            android:contentDescription="@string/detail_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.StoryStep.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/advice_title" />

        <TextView
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/advice_subtitle"
            android:textColor="@color/story_ink_2" />

        <!-- The plan measures from the reference area, so the forecast is for that area. -->
        <TextView
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advice_area"
            android:textColor="@color/story_ink_2" />

        <!-- Shown only when the phone's timezone differs from the forecast area's. -->
        <TextView
            android:id="@+id/advice_zone_note"
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/story_ink_2"
            android:visibility="gone" />

        <TextView
            style="@style/Widget.StoryStep.Eyebrow"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/advice_stay_label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/advice_stay_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/advice_duration"
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/story_ink_2" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/advice_summary"
            style="@style/Widget.StoryStep.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_8"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/advice_best"
                    style="@style/TextAppearance.StoryStep.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/story_ink" />

                <TextView
                    android:id="@+id/advice_note"
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="@color/story_ink_2"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/advice_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:paddingBottom="@dimen/space_16"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <ProgressBar
            android:id="@+id/advice_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/forecast_loading"
            android:indeterminateTint="@color/story_ink_3" />

        <LinearLayout
            android:id="@+id/advice_error_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:visibility="gone">

            <TextView
                android:id="@+id/advice_error"
                style="@style/TextAppearance.StoryStep.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/story_ink_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/advice_retry"
                style="@style/Widget.StoryStep.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/forecast_retry" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/advice_source"
        style="@style/TextAppearance.StoryStep.Supporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/page_horizontal_margin"
        android:paddingBottom="@dimen/space_16"
        android:textColor="@color/story_ink_3"
        android:visibility="gone" />
</LinearLayout>
