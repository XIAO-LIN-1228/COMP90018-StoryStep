<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory">

    <LinearLayout
        android:id="@+id/story_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/app_bar_height"
        android:background="@drawable/bg_brand_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/story_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            style="@style/TextAppearance.StoryStep.AppBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/story_toolbar_title"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/add_memory_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/story_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/story_hero"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/photo_old_arts" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_soft_teal"
                    android:padding="8dp"
                    android:text="@string/story_discovered"
                    android:textColor="@color/brand_teal_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/story_place_name"
                    style="@style/TextAppearance.StoryStep.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/story_body"
                    style="@style/TextAppearance.StoryStep.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp" />

                <!--
                    Where the text came from, stated on the screen that shows it. The seed dataset
                    is not a live provider, and saying so is what keeps a demo from reading as a
                    researched fact about the place.
                -->
                <TextView
                    android:id="@+id/story_attribution"
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/story_attribution"
                    android:textColor="@color/story_text_tertiary" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/story_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="20dp"
                    android:alpha="0.72"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_old_arts_thumb"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.StoryStep.Image" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_memory_button"
        style="@style/Widget.StoryStep.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/primary_button_height"
        android:layout_margin="16dp"
        android:text="@string/story_add_memory"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
