<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.StoryStep.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/summary_title" />

        <TextView
            style="@style/TextAppearance.StoryStep.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/summary_supporting" />

        <com.comp90018.storystep.ui.widget.StoryMapView
            android:id="@+id/summary_map"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_photo_placeholder" />

        <TextView
            style="@style/TextAppearance.StoryStep.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/home_journey_name"
            android:textColor="@color/brand_teal" />

        <TextView
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/summary_date" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_soft_teal"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/summary_time" />

            <TextView
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/summary_distance" />

            <TextView
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/summary_stories" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.StoryStep.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/summary_memories" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <TextView
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:drawableTopCompat="@drawable/photo_old_arts_thumb"
                    android:gravity="bottom"
                    android:padding="10dp"
                    android:text="@string/summary_memory_one" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <TextView
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:drawableTopCompat="@drawable/photo_system_garden"
                    android:gravity="bottom"
                    android:padding="10dp"
                    android:text="@string/summary_memory_two" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_journey_button"
            style="@style/Widget.StoryStep.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_button_height"
            android:layout_marginTop="20dp"
            android:text="@string/summary_view_journey" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/summary_done_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/done"
            android:textColor="@color/brand_teal" />
    </LinearLayout>
</ScrollView>
