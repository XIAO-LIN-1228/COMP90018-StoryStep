<?xml version="1.0" encoding="utf-8"?>
<!--
    A place, as a row: a rounded thumbnail that stands as tall as the text beside it, the name in the display face, the facts as filled
    pills, then a sentence or two about it. The bookmark sits at the top corner so the
    introduction can run the full width beneath it. No divider - the white sheet under the list
    already separates it from the page, and rules between rows only added noise once the sheet
    arrived.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attraction_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="@dimen/page_horizontal_margin"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/space_8"
    android:paddingBottom="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/attraction_image"
        android:layout_width="@dimen/row_thumb_size"
        android:layout_height="0dp"
        android:minHeight="@dimen/row_thumb_size"
        android:background="@drawable/bg_thumb_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@id/attraction_reason"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.StoryStep.Image" />

    <TextView
        android:id="@+id/attraction_name"
        style="@style/TextAppearance.StoryStep.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/attraction_save_button"
        app:layout_constraintStart_toEndOf="@id/attraction_image"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/attraction_facts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/attraction_name"
        app:layout_constraintStart_toStartOf="@id/attraction_name"
        app:layout_constraintTop_toBottomOf="@id/attraction_name">

        <TextView
            android:id="@+id/attraction_distance"
            style="@style/Widget.StoryStep.Pill"
            android:layout_height="24dp"
            android:textColor="@color/story_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/attraction_category"
            style="@style/Widget.StoryStep.Pill"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- A sentence or two; hidden when nothing is known. Runs under the bookmark's column. -->
    <TextView
        android:id="@+id/attraction_reason"
        style="@style/TextAppearance.StoryStep.Supporting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/space_12"
        android:ellipsize="end"
        android:lineSpacingExtra="1sp"
        android:maxLines="6"
        android:textColor="@color/story_ink_3"
        android:textSize="12.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/attraction_name"
        app:layout_constraintTop_toBottomOf="@id/attraction_facts" />

    <ImageButton
        android:id="@+id/attraction_save_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="-8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/detail_save"
        android:padding="10dp"
        android:src="@drawable/ic_bookmark_outline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/story_ink_3" />
</androidx.constraintlayout.widget.ConstraintLayout>
