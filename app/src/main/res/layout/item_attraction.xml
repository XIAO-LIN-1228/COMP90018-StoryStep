<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/attraction_card"
    style="@style/Widget.StoryStep.Card"
    android:layout_width="match_parent"
    android:layout_height="126dp"
    android:layout_marginBottom="@dimen/space_12"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/attraction_image"
            android:layout_width="116dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.StoryStep.Image"
            tools:src="@drawable/photo_old_arts_thumb" />

        <TextView
            android:id="@+id/attraction_name"
            style="@style/TextAppearance.StoryStep.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/attraction_save_button"
            app:layout_constraintStart_toEndOf="@id/attraction_image"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Old Arts Building" />

        <TextView
            android:id="@+id/attraction_category"
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="3dp"
            app:layout_constraintEnd_toStartOf="@id/attraction_save_button"
            app:layout_constraintStart_toEndOf="@id/attraction_image"
            app:layout_constraintTop_toBottomOf="@id/attraction_name"
            tools:text="University landmark" />

        <TextView
            android:id="@+id/attraction_reason"
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintBottom_toTopOf="@id/attraction_distance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/attraction_image"
            app:layout_constraintTop_toBottomOf="@id/attraction_category"
            tools:text="Heritage architecture and university history." />

        <TextView
            android:id="@+id/attraction_distance"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="4dp"
            android:textColor="@color/story_ink"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/attraction_image"
            tools:text="280 m" />

        <!--
            A real toggle rather than the decorative pin this slot used to hold: the saved state
            has to be both visible and changeable from the list. 48dp so the touch target meets the
            accessibility minimum; the icon inside keeps the original visual weight.
        -->
        <ImageButton
            android:id="@+id/attraction_save_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_surface"
            android:contentDescription="@string/attraction_save"
            android:padding="14dp"
            android:src="@drawable/ic_bookmark_outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
