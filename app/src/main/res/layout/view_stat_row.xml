<?xml version="1.0" encoding="utf-8"?>
<!-- A walk in three figures. Include once per screen; the ids are bound by the host. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.StoryStep.StatLabel"
            android:text="@string/summary_time_label" />

        <TextView
            android:id="@+id/stat_duration"
            style="@style/Widget.StoryStep.StatValue"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.StoryStep.StatLabel"
            android:text="@string/summary_distance_label" />

        <TextView
            android:id="@+id/stat_distance"
            style="@style/Widget.StoryStep.StatValue"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.StoryStep.StatLabel"
            android:text="@string/summary_discovered_label" />

        <TextView
            android:id="@+id/stat_stories"
            style="@style/Widget.StoryStep.StatValue"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
