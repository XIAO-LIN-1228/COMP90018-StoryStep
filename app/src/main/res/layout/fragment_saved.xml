<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground">

    <LinearLayout
        android:id="@+id/saved_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/page_horizontal_margin"
        android:paddingBottom="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/saved_back"
            style="@style/Widget.StoryStep.ScrimButton"
            android:contentDescription="@string/detail_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.StoryStep.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/saved_title" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/saved_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/saved_header" />

    <ProgressBar
        android:id="@+id/saved_loading"
        android:contentDescription="@string/saved_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/story_ink_3"
        app:layout_constraintBottom_toBottomOf="@id/saved_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/saved_list" />

    <TextView
        android:id="@+id/saved_message"
        android:accessibilityLiveRegion="polite"
        style="@style/TextAppearance.StoryStep.Prose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal_margin"
        android:layout_marginEnd="@dimen/page_horizontal_margin"
        android:gravity="center"
        android:text="@string/saved_empty"
        app:layout_constraintBottom_toBottomOf="@id/saved_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/saved_list" />
</androidx.constraintlayout.widget.ConstraintLayout>
