<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground">

    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_12"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingEnd="@dimen/page_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/nearby_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nearby_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.StoryStep.Label" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/weather_card"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/story_surface"
            app:strokeColor="@color/story_outline"
            app:strokeWidth="@dimen/hairline"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/weather_reading"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/weather_loading"
                android:textColor="@color/story_on_header"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_location_outline"
                app:drawableTint="@color/story_on_header"
                android:drawablePadding="6dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!--
        The real map. It shows where the user is and where the places are, and nothing else -
        no drawn route to a destination, which would read as navigation. Inset and rounded so
        it sits on the page as a card rather than as a full-bleed slab.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/home_map_card"
        style="@style/Widget.StoryStep.Card"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:layout_marginStart="@dimen/page_horizontal_margin"
        android:layout_marginEnd="@dimen/page_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_header">

        <com.comp90018.storystep.ui.widget.PlaceMapView
            android:id="@+id/home_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/continue_journey_card"
        style="@style/Widget.StoryStep.Card"
        android:layout_width="0dp"
        android:layout_height="124dp"
        android:layout_marginTop="@dimen/space_16"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/story_ground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_map_card">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hairline_top"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:paddingBottom="@dimen/space_16">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/journey_image"
                android:layout_width="92dp"
                android:layout_height="0dp"
                android:contentDescription="@string/home_journey_name"
                android:scaleType="centerCrop"
                android:src="@drawable/photo_old_arts_thumb"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.StoryStep.Image" />

            <TextView
                android:id="@+id/journey_label"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/home_continue_title"
                android:textColor="@color/story_ink"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/journey_image"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/journey_name"
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="@string/home_journey_name"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/journey_image"
                app:layout_constraintTop_toBottomOf="@id/journey_label" />

            <TextView
                android:id="@+id/journey_progress"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="@string/home_journey_progress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/journey_image"
                app:layout_constraintTop_toBottomOf="@id/journey_name" />

            <TextView
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/home_journey_meta"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/journey_image" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resume_journey_button"
                style="@style/Widget.StoryStep.Button.Primary"
                android:layout_width="124dp"
                android:layout_height="42dp"
                android:minHeight="42dp"
                android:text="@string/home_resume"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_container"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_16"
        android:hint="@string/search_places"
        android:visibility="gone"
        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
        app:boxBackgroundColor="@color/story_surface"
        app:boxStrokeColor="@color/story_outline"
        app:boxStrokeWidth="@dimen/hairline"
        app:boxStrokeWidthFocused="@dimen/hairline"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/story_ink_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_header">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/home_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:minHeight="54dp"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filter_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_16"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_container">

        <com.google.android.material.chip.Chip android:id="@+id/chip_all" style="@style/Widget.StoryStep.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/home_filter_all" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_indoor" style="@style/Widget.StoryStep.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_filter_indoor" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_outdoor" style="@style/Widget.StoryStep.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_filter_outdoor" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_unvisited" style="@style/Widget.StoryStep.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_filter_unvisited" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:id="@+id/nearby_section_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/page_horizontal_margin"
        android:paddingBottom="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/continue_journey_card">

        <TextView
            android:id="@+id/nearby_title"
            style="@style/TextAppearance.StoryStep.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_nearby" />

        <!-- How many of the loaded places have had their story read: the collection count. -->
        <TextView
            android:id="@+id/unlock_progress"
            style="@style/Widget.StoryStep.Pill"
            android:layout_marginEnd="@dimen/space_8"
            android:textColor="@color/story_signal_ink"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_lock_outline"
            app:drawableTint="@color/story_signal_ink" />

        <TextView
            android:id="@+id/see_all_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/minimum_touch_target"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:text="@string/home_see_all"
            android:textColor="@color/story_ink"
            android:textSize="14sp"
            android:fontFamily="@font/jakarta_semibold" />
    </LinearLayout>

    <!-- Offline / stale: shown only when the list is stored content rather than a current answer. -->
    <TextView
        android:id="@+id/stale_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal_margin"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/page_horizontal_margin"
        android:background="@drawable/bg_stale_banner"
        android:drawablePadding="@dimen/space_8"
        android:fontFamily="@font/jakarta_medium"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="10dp"
        android:text="@string/nearby_cached_notice"
        android:textColor="@color/story_on_ink"
        android:textSize="@dimen/text_supporting"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_info_outline"
        app:drawableTint="@color/story_on_ink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearby_section_header" />

    <!--
        States which position the listed distances are measured from. This must always be visible:
        distances from the demonstration reference area must never be mistaken for distances from
        the user.
    -->
    <TextView
        android:id="@+id/origin_label"
        style="@style/TextAppearance.StoryStep.Supporting"
        android:textColor="@color/story_ink_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal_margin"
        android:layout_marginEnd="@dimen/page_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stale_banner"
        app:layout_goneMarginTop="0dp"
        tools:text="@string/nearby_origin_reference_area" />

    <!--
        Location explanation and its recovery action. Deliberately sits above the list rather than
        in the centred status area: reference-area content is already on screen at launch, so an
        explanation that only appears on an empty list would never be shown at all.
    -->
    <LinearLayout
        android:id="@+id/permission_notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_16"
        android:background="@drawable/bg_inset_note"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/origin_label"
        tools:visibility="visible">

        <TextView
            android:id="@+id/permission_notice_message"
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/nearby_permission_rationale" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permission_notice_action"
            style="@style/Widget.StoryStep.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            tools:text="@string/nearby_grant_access" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/attraction_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:clipToPadding="false"
        android:contentDescription="@string/nearby_list_description"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@id/session_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/permission_notice"
        app:layout_goneMarginTop="@dimen/space_8" />

    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/nearby_loading"
        app:layout_constraintBottom_toBottomOf="@id/attraction_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/attraction_list" />

    <TextView
        android:id="@+id/status_message"
        style="@style/TextAppearance.StoryStep.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@id/retry_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/attraction_list"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="@string/nearby_empty" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retry_button"
        style="@style/Widget.StoryStep.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/nearby_retry"
        app:layout_constraintBottom_toBottomOf="@id/attraction_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_message" />

    <!--
        The only thing that starts location collection. Nothing is requested or registered until
        the user presses this. Its label follows the session phase: Start, Stop or Resume.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/session_button"
        android:elevation="@dimen/floating_elevation"
        style="@style/Widget.StoryStep.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal_margin"
        android:layout_marginEnd="@dimen/page_horizontal_margin"
        android:layout_marginBottom="@dimen/space_12"
        android:minHeight="@dimen/minimum_touch_target"
        android:text="@string/nearby_start_exploring"
        app:layout_constraintBottom_toTopOf="@id/stop_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        Only shown while the session is paused, so a session interrupted by leaving the app can be
        ended without first resuming collection.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stop_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:text="@string/nearby_stop_exploring"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
