<?xml version="1.0" encoding="utf-8"?>
<!--
    Explore: the map is the page. It fills the screen; the title, the weather and the
    filters float over its top; the places live in a sheet that rests at the bottom and
    can be pulled up to fill the screen. Two states only - resting and full - so the map
    is always either the view or one drag away.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground">

    <FrameLayout
        android:id="@+id/home_map_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.comp90018.storystep.ui.widget.PlaceMapView
            android:id="@+id/home_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Title, weather and filters float over the map on a soft scrim. -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_map_top_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/page_horizontal_margin"
        android:paddingBottom="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/nearby_back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="@dimen/space_4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nearby_back"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:visibility="gone"
                app:tint="@color/story_ink" />

            <TextView
                android:id="@+id/home_title"
                style="@style/TextAppearance.StoryStep.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/weather_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/weather_reading"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weather_loading"
                android:textColor="@color/story_ink_2" />
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

    <!-- The sheet: resting shows the first places; a pull fills the screen. -->
    <LinearLayout
        android:id="@+id/places_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet"
        android:elevation="@dimen/floating_elevation"
        android:orientation="vertical"
        app:behavior_expandedOffset="0dp"
        app:behavior_fitToContents="false"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/sheet_peek_height"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:id="@+id/nearby_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:paddingBottom="@dimen/space_4">

            <TextView
                android:id="@+id/nearby_title"
                style="@style/TextAppearance.StoryStep.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_nearby" />

            <TextView
                android:id="@+id/see_all_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/minimum_touch_target"
                android:fontFamily="@font/bricolage_semibold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="@string/home_see_all"
                android:textColor="@color/story_ink"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ordering_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/order_recommended"
                style="@style/Widget.StoryStep.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/order_recommended"
                app:ensureMinTouchTargetSize="true" />
            <com.google.android.material.chip.Chip
                android:id="@+id/order_nearby"
                style="@style/Widget.StoryStep.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/order_nearby"
                app:ensureMinTouchTargetSize="true" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/unlock_progress"
            style="@style/Widget.StoryStep.Pill"
            android:layout_marginStart="@dimen/page_horizontal_margin"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/story_signal_ink"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_lock_outline"
            app:drawableTint="@color/story_signal_ink" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clipToPadding="false"
            android:scrollbars="none">

<com.google.android.material.chip.ChipGroup
        android:id="@+id/filter_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_16"
        android:visibility="gone">

        <com.google.android.material.chip.Chip android:id="@+id/chip_all" style="@style/Widget.StoryStep.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/home_filter_all" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_indoor" style="@style/Widget.StoryStep.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_filter_indoor" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_outdoor" style="@style/Widget.StoryStep.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_filter_outdoor" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_unvisited" style="@style/Widget.StoryStep.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_filter_unvisited" />
    </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

<com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_container"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_8"
        android:hint="@string/search_places"
        android:visibility="gone"
        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
        app:boxBackgroundColor="@color/story_surface"
        app:boxStrokeColor="@color/story_outline"
        app:boxStrokeWidth="@dimen/hairline"
        app:boxStrokeWidthFocused="@dimen/hairline"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/story_ink_2">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/home_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:minHeight="40dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textSize="14sp"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/stale_banner"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_horizontal_margin"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/page_horizontal_margin"
            android:background="@drawable/bg_stale_banner"
            android:drawablePadding="@dimen/space_8"
            android:fontFamily="@font/bricolage_medium"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="10dp"
            android:text="@string/nearby_cached_notice"
            android:textColor="@color/story_on_ink"
            android:textSize="@dimen/text_supporting"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_info_outline"
            app:drawableTint="@color/story_on_ink" />

        <!-- Kept for the fragment's binding; the provenance line no longer shows here. -->
        <TextView
            android:id="@+id/origin_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:textAppearance="@style/TextAppearance.StoryStep.Supporting"
            android:visibility="gone" />

<LinearLayout
        android:id="@+id/permission_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_16"
        android:background="@drawable/bg_inset_note"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/permission_notice_message"
            android:accessibilityLiveRegion="polite"
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/nearby_permission_rationale" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permission_notice_action"
            style="@style/Widget.StoryStep.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            tools:text="@string/nearby_grant_access" />

    </LinearLayout>

<com.google.android.material.card.MaterialCardView
        android:id="@+id/continue_journey_card"
        style="@style/Widget.StoryStep.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/story_ground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hairline_top"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:paddingBottom="@dimen/space_16">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/journey_image"
                android:layout_width="92dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/photo_old_arts_thumb"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.StoryStep.Image" />

            <TextView
                android:id="@+id/journey_label"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/home_continue_title"
                android:textColor="@color/story_ink"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/journey_image"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/journey_name"
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="@string/home_journey_name"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/journey_image"
                app:layout_constraintTop_toBottomOf="@id/journey_label" />

            <TextView
                android:id="@+id/journey_progress"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="@string/home_journey_progress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/journey_image"
                app:layout_constraintTop_toBottomOf="@id/journey_name" />

            <TextView
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/home_journey_meta"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/journey_image" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resume_journey_button"
                style="@style/Widget.StoryStep.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="124dp"
                android:minHeight="42dp"
                android:text="@string/home_resume"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/attraction_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="146dp" />

            <ProgressBar
                android:id="@+id/loading_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/nearby_loading"
                android:indeterminateTint="@color/story_ink_3" />

            <TextView
                android:id="@+id/status_message"
                android:accessibilityLiveRegion="polite"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="@dimen/page_horizontal_margin"
                android:paddingEnd="@dimen/page_horizontal_margin"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                style="@style/Widget.StoryStep.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="88dp"
                android:text="@string/nearby_retry"
                android:visibility="gone" />

            <!-- The one action, floating over the list's foot. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="86dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/session_button"
                    style="@style/Widget.StoryStep.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="@dimen/floating_elevation"
                    android:minHeight="@dimen/minimum_touch_target"
                    android:text="@string/nearby_start_exploring" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stop_button"
                    style="@style/Widget.StoryStep.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:minHeight="@dimen/minimum_touch_target"
                    android:text="@string/nearby_stop_exploring"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- The place-data credit the licence requires, shown when the map's own is hidden. -->
        <TextView
            android:id="@+id/list_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bricolage"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="80dp"
            android:text="@string/nearby_list_credit"
            android:textColor="@color/story_ink_3"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Back to where you are. -->
    <ImageButton
        android:id="@+id/recenter_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/sheet_peek_height"
        android:background="@drawable/bg_scrim_button"
        android:contentDescription="@string/nearby_recenter"
        android:elevation="@dimen/card_elevation"
        android:padding="11dp"
        android:src="@drawable/ic_recenter"
        app:tint="@color/story_ink" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
