<?xml version="1.0" encoding="utf-8"?>
<!--
    A walk, as a row: the name it was given, the date and the figures underneath in
    tabular type so the column reads down the list. Delete stays a quiet trailing
    control rather than a red button on every row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <View style="@style/Widget.StoryStep.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/minimum_touch_target"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/row_vertical_padding"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/row_vertical_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/journey_item_title"
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/journey_item_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textAppearance="@style/TextAppearance.StoryStep.Label" />

            <TextView
                android:id="@+id/journey_item_stats"
                style="@style/TextAppearance.StoryStep.Metric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/story_ink_2" />

            <!-- Weather, movement or an interruption: whatever this walk was actually like. -->
            <TextView
                android:id="@+id/journey_item_label"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/story_ink_3" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/journey_item_delete"
            android:layout_width="@dimen/minimum_touch_target"
            android:layout_height="@dimen/minimum_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/history_delete"
            android:padding="12dp"
            android:src="@drawable/ic_delete_outline"
            app:tint="@color/story_ink_3" />
    </LinearLayout>
</LinearLayout>
