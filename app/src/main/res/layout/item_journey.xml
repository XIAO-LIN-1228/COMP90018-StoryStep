<?xml version="1.0" encoding="utf-8"?>
<!--
    A walk as a feed post, the unit of the reference: who walked and when, the name the user
    gave it, the three figures, then the photographs they attached, swiped one at a time. A
    white card on the paper; delete stays a quiet trailing control on the identity line.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.StoryStep.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_horizontal_margin"
    android:layout_marginTop="@dimen/space_8"
    android:layout_marginEnd="@dimen/page_horizontal_margin"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/journey_item_header"
                    layout="@layout/view_journey_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/journey_item_delete"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_marginEnd="-8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/history_delete"
                    android:padding="10dp"
                    android:src="@drawable/ic_delete_outline"
                    app:tint="@color/story_ink_3" />
            </LinearLayout>

            <!-- Kept for the adapter contract; the date renders in the identity line. -->
            <TextView
                android:id="@+id/journey_item_date"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/journey_item_title"
                style="@style/TextAppearance.StoryStep.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:ellipsize="end"
                android:maxLines="2" />

            <!-- Kept for the adapter contract; the figures render in the columns below. -->
            <TextView
                android:id="@+id/journey_item_stats"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <include
                layout="@layout/view_stat_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12" />

            <!-- Interrupted, or with gaps: the honesty label, as a brand-coloured pill. -->
            <TextView
                android:id="@+id/journey_item_label"
                style="@style/Widget.StoryStep.Pill"
                android:layout_marginTop="@dimen/space_12"
                android:textColor="@color/story_signal_ink"
                android:visibility="gone" />
        </LinearLayout>

        <!--
            The photographs run to the card's own edges and bottom, square on top where they
            meet the text; the card's outline rounds the bottom corners.
        -->
        <com.comp90018.storystep.ui.journey.JourneyPhotoPager
            android:id="@+id/journey_item_photos"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
