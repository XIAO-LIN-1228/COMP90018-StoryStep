<?xml version="1.0" encoding="utf-8"?>
<!--
    One hour (forecast page) or one departure (advice page): when, condition icon, chance of rain
    and a bar of that length. The label line under it is used by departure advice only.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/minimum_touch_target"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rain_row_time"
            style="@style/TextAppearance.StoryStep.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/story_ink" />

        <ImageView
            android:id="@+id/rain_row_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/space_8"
            app:tint="@color/story_ink_2"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/rain_row_percent"
            style="@style/TextAppearance.StoryStep.Body"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/story_ink" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/rain_row_bar"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:importantForAccessibility="no"
            android:max="100"
            app:indicatorColor="@color/story_ink_2"
            app:trackColor="@color/story_hairline"
            app:trackCornerRadius="2dp"
            app:trackThickness="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rain_row_label"
        style="@style/TextAppearance.StoryStep.Supporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="@color/story_ink_2"
        android:visibility="gone" />
</LinearLayout>
