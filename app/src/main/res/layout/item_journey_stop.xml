<?xml version="1.0" encoding="utf-8"?>
<!-- One place visited during a journey. Clickable only when a story was actually recorded. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/journey_stop_name"
        style="@style/TextAppearance.StoryStep.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        tools:text="Old Arts Building" />

    <TextView
        android:id="@+id/journey_stop_meta"
        style="@style/TextAppearance.StoryStep.Supporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        tools:text="Arrived 10:14" />
</LinearLayout>
