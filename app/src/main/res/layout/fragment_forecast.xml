<?xml version="1.0" encoding="utf-8"?>
<!--
    Hourly forecast: the next 24 hours of rain chance for the home weather card's area, one row
    per hour. Loading, error and list share the space under the header; one shows at a time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/page_horizontal_margin">

        <ImageButton
            android:id="@+id/forecast_back"
            style="@style/Widget.StoryStep.ScrimButton"
            android:contentDescription="@string/detail_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.StoryStep.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/forecast_title" />

        <TextView
            android:id="@+id/forecast_area"
            style="@style/TextAppearance.StoryStep.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_8"
            android:textColor="@color/story_ink_2" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/forecast_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:paddingBottom="@dimen/space_32"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <ProgressBar
            android:id="@+id/forecast_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/forecast_loading"
            android:indeterminateTint="@color/story_ink_3" />

        <LinearLayout
            android:id="@+id/forecast_error_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:visibility="gone">

            <TextView
                android:id="@+id/forecast_error"
                style="@style/TextAppearance.StoryStep.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/story_ink_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forecast_retry"
                style="@style/Widget.StoryStep.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/forecast_retry" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        style="@style/TextAppearance.StoryStep.Supporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/page_horizontal_margin"
        android:paddingBottom="@dimen/space_16"
        android:text="@string/forecast_source"
        android:textColor="@color/story_ink_3" />
</LinearLayout>
