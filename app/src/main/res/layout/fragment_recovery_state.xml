<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/recovery_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/detail_back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/recovery_icon"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/bg_soft_teal"
        android:contentDescription="@null"
        android:padding="28dp"
        android:src="@drawable/ic_location_outline"
        app:layout_constraintBottom_toTopOf="@id/recovery_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recovery_back" />

    <TextView
        android:id="@+id/recovery_title"
        style="@style/TextAppearance.StoryStep.Headline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/recovery_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recovery_icon"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/recovery_body"
        style="@style/TextAppearance.StoryStep.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        app:layout_constraintBottom_toTopOf="@id/recovery_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recovery_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recovery_primary"
        style="@style/Widget.StoryStep.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/primary_button_height"
        android:layout_marginTop="28dp"
        app:layout_constraintBottom_toTopOf="@id/recovery_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recovery_body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recovery_secondary"
        style="@style/Widget.StoryStep.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="@dimen/primary_button_height"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recovery_primary" />
</androidx.constraintlayout.widget.ConstraintLayout>
