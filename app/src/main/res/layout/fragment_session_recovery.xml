<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_bar_height"
            android:background="@drawable/bg_brand_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/space_16">

            <ImageButton
                android:id="@+id/session_recovery_back"
                android:layout_width="@dimen/minimum_touch_target"
                android:layout_height="@dimen/minimum_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/story_on_header" />

            <TextView
                style="@style/TextAppearance.StoryStep.AppBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/session_recovery_title"
                android:textColor="@color/story_on_header"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_horizontal_margin">

            <TextView
                android:id="@+id/session_recovery_paused_label"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_amber"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/session_recovery_paused"
                android:textColor="@color/story_ink"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.StoryStep.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/session_recovery_headline" />

            <TextView
                style="@style/TextAppearance.StoryStep.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/session_recovery_body" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="112dp"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="104dp"
                            android:layout_height="112dp"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/photo_old_arts_thumb"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.StoryStep.Image" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.StoryStep.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/session_recovery_current_journey" />

                            <TextView
                                android:id="@+id/session_recovery_checkpoint"
                                style="@style/TextAppearance.StoryStep.Supporting"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/session_recovery_checkpoint_pending"
                                android:textColor="@color/story_ink"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.StoryStep.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_soft_teal"
                android:padding="@dimen/space_16"
                android:text="@string/session_recovery_privacy_note"
                android:textColor="@color/story_ink_pressed" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/session_recovery_resume"
                style="@style/Widget.StoryStep.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/session_recovery_resume" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/session_recovery_finish"
                style="@style/Widget.StoryStep.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/session_recovery_finish" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/session_recovery_discard"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/minimum_touch_target"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/session_recovery_discard"
                android:textColor="@color/story_error" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
