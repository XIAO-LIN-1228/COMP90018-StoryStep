<?xml version="1.0" encoding="utf-8"?>
<!--
    A finished walk, summarised the way a tour is: the name as the page title, the date
    as meta, the three figures in a stat row, the route as a white card on the paper,
    then the record of what the walk was actually like. Explore again floats as the
    one brand-coloured action.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground">

    <LinearLayout
        android:id="@+id/journey_detail_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/page_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/journey_detail_back"
            style="@style/Widget.StoryStep.ScrimButton"
            android:contentDescription="@string/detail_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/journey_detail_title"
            style="@style/TextAppearance.StoryStep.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            tools:text="Walk to Old Arts Building" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/journey_detail_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/story_ink_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/journey_detail_header" />

    <TextView
        android:id="@+id/journey_detail_status"
        style="@style/TextAppearance.StoryStep.Prose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/page_horizontal_margin"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/journey_detail_header"
        tools:text="This journey is no longer on this device." />

    <ScrollView
        android:id="@+id/journey_detail_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/journey_detail_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/page_horizontal_margin">

            <!-- Kept for the summary contract; the date renders in the identity line. -->
            <TextView
                android:id="@+id/journey_detail_date"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <include
                layout="@layout/view_journey_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!--
                Publishing, offered once: name the walk, add a few photographs, publish. Hidden
                as soon as the walk has a name, so a walk seen again is simply a walk.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/journey_publish_card"
                style="@style/Widget.StoryStep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        style="@style/TextAppearance.StoryStep.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/journey_publish_heading" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        app:boxBackgroundColor="@color/story_surface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/story_outline"
                        app:boxStrokeWidth="@dimen/hairline"
                        app:boxStrokeWidthFocused="@dimen/hairline"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/journey_title_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/journey_title_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textCapSentences"
                            android:maxLength="60"
                            android:minHeight="44dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:singleLine="true"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/journey_photo_strip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/journey_add_photos"
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:background="@drawable/bg_add_photo"
                                android:clickable="true"
                                android:contentDescription="@string/journey_add_photos"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_add_photo"
                                    app:tint="@color/story_ink_3" />
                            </FrameLayout>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/journey_publish_button"
                        style="@style/Widget.StoryStep.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/primary_button_height"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/journey_publish" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Interrupted or with gaps: the honesty label, in the brand colour. -->
            <TextView
                android:id="@+id/journey_detail_label"
                style="@style/Widget.StoryStep.Pill"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_chip_filled"
                android:textColor="@color/story_signal_ink"
                android:visibility="gone"
                tools:text="Interrupted"
                tools:visibility="visible" />

            <!-- Kept for the summary contract; the figures now render in the stat row. -->
            <TextView
                android:id="@+id/journey_detail_stats"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <include
                layout="@layout/view_stat_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24" />

            <com.comp90018.storystep.ui.journey.JourneyPhotoPager
                android:id="@+id/journey_detail_photos"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="@dimen/space_24"
                android:visibility="gone" />

            <!-- The route as a white card on the paper. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24">

                <com.comp90018.storystep.ui.widget.PlaceMapView
                    android:id="@+id/journey_detail_route"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/journey_detail_route_caption"
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/history_route_caption"
                android:textColor="@color/story_ink_3" />

            <TextView
                style="@style/Widget.StoryStep.StatLabel"
                android:layout_marginTop="@dimen/space_32"
                android:text="@string/history_movement_label" />

            <TextView
                android:id="@+id/journey_detail_movement"
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Moving 31 min · still 11 min" />

            <TextView
                style="@style/Widget.StoryStep.StatLabel"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/history_weather_label" />

            <TextView
                android:id="@+id/journey_detail_weather"
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Cloudy 14°C · recorded 10:42" />

            <TextView
                android:id="@+id/journey_detail_places_heading"
                style="@style/TextAppearance.StoryStep.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:text="@string/journey_detail_places" />

            <LinearLayout
                android:id="@+id/journey_detail_stops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/explore_again_button"
        style="@style/Widget.StoryStep.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/primary_button_height"
        android:layout_marginBottom="@dimen/space_24"
        android:elevation="@dimen/floating_elevation"
        android:text="@string/journey_explore_again"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
