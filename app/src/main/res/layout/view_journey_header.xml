<?xml version="1.0" encoding="utf-8"?>
<!--
    The identity line of a published walk, the feed unit of the reference: the avatar, who
    walked, then when and where. Included by the card and the detail page alike.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/journey_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/journey_who"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/bricolage_semibold"
            android:maxLines="1"
            android:textColor="@color/story_ink"
            android:textSize="14.5sp"
            tools:text="You went for a walk" />

        <TextView
            android:id="@+id/journey_when_where"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/bricolage"
            android:maxLines="1"
            android:textColor="@color/story_ink_3"
            android:textSize="12.5sp"
            tools:text="6 Sep 2026 at 13:21 · Parkville, Australia" />
    </LinearLayout>
</LinearLayout>
