<?xml version="1.0" encoding="utf-8"?>
<!--
    The profile is about the walker: who they are, what they have done, the walks they took
    and the places they kept. Settings live behind the gear at the top right, on their own
    page, so nothing about the device or the app sits between the person and their record.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="98dp">

        <!-- The gear, alone on the top line, as the reference keeps it. -->
        <ImageButton
            android:id="@+id/profile_settings"
            style="@style/Widget.StoryStep.ScrimButton"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/page_horizontal_margin"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />

        <!-- Who: a large avatar, the name, one line about the walker, one more about them. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.StoryStep.PageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_name" />

                <TextView
                    android:id="@+id/profile_subtitle"
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_local"
                    android:textColor="@color/story_ink_3"
                    tools:text="Exploring since Sep 2026 · Parkville" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/profile_bio"
            style="@style/TextAppearance.StoryStep.Prose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:text="@string/profile_bio"
            android:textColor="@color/story_ink_2" />

        <!-- The record: four figures in one white card. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StoryStep.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_horizontal_margin"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginEnd="@dimen/page_horizontal_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="14dp"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.StoryStep.StatLabel"
                        android:text="@string/profile_journeys_label" />

                    <TextView
                        android:id="@+id/profile_journeys_count"
                        style="@style/Widget.StoryStep.StatValue"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_count_unknown" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.StoryStep.StatLabel"
                        android:text="@string/profile_distance_label" />

                    <TextView
                        android:id="@+id/profile_distance_total"
                        style="@style/Widget.StoryStep.StatValue"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_count_unknown" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.StoryStep.StatLabel"
                        android:text="@string/profile_visits_short_label" />

                    <TextView
                        android:id="@+id/profile_visits_count"
                        style="@style/Widget.StoryStep.StatValue"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_count_unknown" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.StoryStep.StatLabel"
                        android:text="@string/profile_saves_short_label" />

                    <TextView
                        android:id="@+id/profile_saves_count"
                        style="@style/Widget.StoryStep.StatValue"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_count_unknown" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The walks, most recent first, as photographs; hidden until there is one. -->
        <TextView
            android:id="@+id/profile_walks_heading"
            style="@style/TextAppearance.StoryStep.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:text="@string/profile_recent_walks"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_walks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/space_8"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_profile_walk"
            tools:visibility="visible" />

        <!-- The places kept, as photographs; hidden until there is one. -->
        <TextView
            android:id="@+id/profile_saved_heading"
            style="@style/TextAppearance.StoryStep.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:text="@string/profile_saved_places"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_saved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/space_8"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_profile_place"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
