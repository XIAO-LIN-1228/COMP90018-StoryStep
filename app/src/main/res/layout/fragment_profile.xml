<?xml version="1.0" encoding="utf-8"?>
<!--
    The profile is about the walker: who they are, what they have done, the walks they took
    and the places they kept. Settings live behind the gear at the top right, on their own
    page, so nothing about the device or the app sits between the person and their record.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="98dp">

        <!-- The gear, alone on the top line, as the reference keeps it. -->
        <ImageButton
            android:id="@+id/profile_settings"
            style="@style/Widget.StoryStep.ScrimButton"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/page_horizontal_margin"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />

        <!-- Who: a large avatar, the name, one line about the walker, one more about them. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.StoryStep.PageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_name" />

                <TextView
                    android:id="@+id/profile_subtitle"
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_local"
                    android:textColor="@color/story_ink_3"
                    tools:text="Exploring since Sep 2026 · Parkville" />
            </LinearLayout>
        </LinearLayout>

        <!-- The record: four figures, each its own tile with an icon, two to a row. The text
             starts under the icon's centre, half the disc in. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stat_icon"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_journeys"
                        app:tint="@color/story_signal_ink" />

                    <TextView
                        android:id="@+id/profile_journeys_count"
                        style="@style/Widget.StoryStep.StatValue"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/profile_count_unknown"
                        android:textSize="24sp" />

                    <TextView
                        style="@style/Widget.StoryStep.StatLabel"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_journeys_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/space_12"
                android:layout_height="0dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stat_icon"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_start_walk"
                        app:tint="@color/story_signal_ink" />

                    <TextView
                        android:id="@+id/profile_distance_total"
                        style="@style/Widget.StoryStep.StatValue"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/profile_count_unknown"
                        android:textSize="24sp" />

                    <TextView
                        style="@style/Widget.StoryStep.StatLabel"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_distance_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stat_icon"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_location_outline"
                        app:tint="@color/story_signal_ink" />

                    <TextView
                        android:id="@+id/profile_visits_count"
                        style="@style/Widget.StoryStep.StatValue"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/profile_count_unknown"
                        android:textSize="24sp" />

                    <TextView
                        style="@style/Widget.StoryStep.StatLabel"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_visits_short_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/space_12"
                android:layout_height="0dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stat_icon"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_bookmark_outline"
                        app:tint="@color/story_signal_ink" />

                    <TextView
                        android:id="@+id/profile_saves_count"
                        style="@style/Widget.StoryStep.StatValue"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/profile_count_unknown"
                        android:textSize="24sp" />

                    <TextView
                        style="@style/Widget.StoryStep.StatLabel"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_saves_short_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <!-- The walks, most recent first, as photographs; hidden until there is one. -->
        <TextView
            android:id="@+id/profile_walks_heading"
            style="@style/TextAppearance.StoryStep.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:text="@string/profile_recent_walks"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_walks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/space_8"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_profile_walk"
            tools:visibility="visible" />


        <!-- The places kept, as photographs, with the full list a tap away. -->
        <LinearLayout
            android:id="@+id/profile_saved_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/TextAppearance.StoryStep.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_saved_places" />

            <TextView
                android:id="@+id/profile_saved_all"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/minimum_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/bricolage_semibold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="@string/home_see_all"
                android:textColor="@color/story_signal_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_saved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingEnd="@dimen/space_8"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_profile_place"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
