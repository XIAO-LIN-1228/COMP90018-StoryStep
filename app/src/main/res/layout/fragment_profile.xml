<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
            A top-level page opens on its own title, left-aligned like every other page,
            rather than on a centred avatar over a slab of colour. The figures below are
            the reason to come back, so they get metric type and a rule to sit on.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_margin"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/page_horizontal_margin"
            android:paddingBottom="98dp">

            <TextView
                style="@style/Widget.StoryStep.Eyebrow"
                android:text="@string/profile_local" />

            <TextView
                style="@style/TextAppearance.StoryStep.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/profile_title" />

            <View
                style="@style/Widget.StoryStep.Divider"
                android:layout_marginTop="@dimen/space_24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView

                        style="@style/Widget.StoryStep.StatLabel"

                        android:text="@string/profile_journeys_label" />


                    <TextView

                        style="@style/Widget.StoryStep.StatValue"

                        android:layout_marginTop="4dp"

                        android:text="@string/profile_journeys_count" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView

                        style="@style/Widget.StoryStep.StatLabel"

                        android:text="@string/profile_stories_label" />


                    <TextView

                        style="@style/Widget.StoryStep.StatValue"

                        android:layout_marginTop="4dp"

                        android:text="@string/profile_stories_count" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView

                        style="@style/Widget.StoryStep.StatLabel"

                        android:text="@string/profile_memories_label" />


                    <TextView

                        style="@style/Widget.StoryStep.StatValue"

                        android:layout_marginTop="4dp"

                        android:text="@string/profile_memories_count" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoryStep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_horizontal_margin"
                android:layout_marginEnd="@dimen/page_horizontal_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/location_settings_row" android:layout_width="match_parent" android:layout_height="@dimen/settings_row_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_surface" android:contentDescription="@null" android:padding="9dp" android:src="@drawable/ic_location_outline" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/TextAppearance.StoryStep.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_location" android:textColor="@color/story_ink" />
                            <TextView style="@style/TextAppearance.StoryStep.Supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_location_value" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="@color/story_hairline" />

                    <LinearLayout android:id="@+id/sensor_settings_row" android:layout_width="match_parent" android:layout_height="@dimen/settings_row_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_surface" android:contentDescription="@null" android:padding="9dp" android:src="@drawable/ic_sensor_outline" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/TextAppearance.StoryStep.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_sensor" android:textColor="@color/story_ink" />
                            <TextView style="@style/TextAppearance.StoryStep.Supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_sensor_value" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="@color/story_hairline" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/settings_row_height" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_surface" android:contentDescription="@null" android:padding="9dp" android:src="@drawable/ic_ruler_outline" />
                        <TextView style="@style/TextAppearance.StoryStep.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/settings_units" android:textColor="@color/story_ink" />
                        <TextView style="@style/TextAppearance.StoryStep.Supporting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_units_value" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="@color/story_hairline" />

                    <LinearLayout android:id="@+id/privacy_data_row" android:layout_width="match_parent" android:layout_height="@dimen/settings_row_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_surface" android:contentDescription="@null" android:padding="9dp" android:src="@drawable/ic_lock_outline" />
                        <TextView style="@style/TextAppearance.StoryStep.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/settings_privacy" android:textColor="@color/story_ink" />
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="@color/story_hairline" />

                    <LinearLayout android:id="@+id/clear_history_row" android:layout_width="match_parent" android:layout_height="@dimen/settings_row_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_error_icon_surface" android:contentDescription="@null" android:padding="9dp" android:src="@drawable/ic_delete_outline" />
                        <TextView style="@style/TextAppearance.StoryStep.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/settings_clear" android:textColor="@color/story_error" />
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="@color/story_hairline" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/settings_row_height" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_surface" android:contentDescription="@null" android:padding="9dp" android:src="@drawable/ic_info_outline" />
                        <TextView style="@style/TextAppearance.StoryStep.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/settings_about" android:textColor="@color/story_ink" />
                        <TextView style="@style/TextAppearance.StoryStep.Supporting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_version" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
