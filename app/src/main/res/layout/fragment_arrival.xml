<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/photo_old_arts" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CFFBF7F1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardBackgroundColor="@color/brand_teal"
            app:cardCornerRadius="48dp"
            app:cardElevation="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/icon_check"
                android:textColor="@color/white"
                android:textSize="48sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.StoryStep.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/arrival_title" />

        <TextView
            style="@style/TextAppearance.StoryStep.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/arrival_place"
            android:textColor="@color/brand_teal" />

        <TextView
            style="@style/TextAppearance.StoryStep.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/arrival_supporting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discover_story_button"
            style="@style/Widget.StoryStep.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_button_height"
            android:layout_marginTop="36dp"
            android:text="@string/arrival_discover" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/arrival_not_now_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/not_now"
            android:textColor="@color/brand_teal" />
    </LinearLayout>
</FrameLayout>
