<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@color/story_surface" android:padding="16dp" android:layout_marginTop="16dp">
    <TextView android:id="@+id/theme_stop_name" style="@style/TextAppearance.StoryStep.Title"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/theme_stop_status" style="@style/TextAppearance.StoryStep.Supporting"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/theme_stop_select"
        style="@style/Widget.StoryStep.Button.Primary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/theme_choose_stop" />
    <com.google.android.material.button.MaterialButton android:id="@+id/theme_stop_skip"
        style="@style/Widget.StoryStep.Button.Secondary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/theme_skip" />
    <TextView android:id="@+id/theme_stop_story" style="@style/TextAppearance.StoryStep.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/theme_stop_source" style="@style/TextAppearance.StoryStep.Supporting"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:autoLink="web"
        android:layout_marginTop="8dp" />
    <TextView android:id="@+id/theme_stop_question" style="@style/TextAppearance.StoryStep.Title"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
    <RadioGroup android:id="@+id/theme_stop_options" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/theme_stop_answer" style="@style/TextAppearance.StoryStep.Supporting"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
</LinearLayout>
