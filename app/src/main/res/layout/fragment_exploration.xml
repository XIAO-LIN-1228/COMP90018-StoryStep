<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory">

    <LinearLayout
        android:id="@+id/exploration_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/app_bar_height"
        android:background="@drawable/bg_brand_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/exploration_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/exploration_title"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.comp90018.storystep.ui.widget.StoryMapView
        android:id="@+id/exploration_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/exploration_guidance_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/exploration_header" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/exploration_guidance_card"
        style="@style/Widget.StoryStep.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_teal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="@string/exploration_approximate"
                android:textColor="@color/brand_teal_dark"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.StoryStep.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/exploration_heading" />

            <TextView
                style="@style/TextAppearance.StoryStep.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/exploration_remaining"
                android:textColor="@color/brand_teal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@color/story_surface_muted"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/exploration_walking" />

                <TextView
                    style="@style/TextAppearance.StoryStep.Supporting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exploration_accuracy" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.StoryStep.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/exploration_notice" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preview_arrival_button"
                style="@style/Widget.StoryStep.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_button_height"
                android:layout_marginTop="12dp"
                android:text="@string/exploration_preview_arrival" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop_exploration_button"
                style="@style/Widget.StoryStep.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_button_height"
                android:layout_marginTop="8dp"
                android:text="@string/exploration_stop"
                android:textColor="@color/story_error"
                app:strokeColor="@color/story_error" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
