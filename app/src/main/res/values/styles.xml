<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Every TextAppearance below sets the face twice: android:fontFamily and the app-namespaced
      fontFamily. AppCompat reads the latter first, and the Material parents set it to the
      system face - so a style that set only the android attribute was silently rendering in
      Roboto while the buttons, which use widget styles, showed the real face.

      Type. The display ramp is set tight and slightly negative-tracked so a place name
      reads as a name printed on a map rather than a product heading. Every style that
      can carry a figure asks for tabular numerals, so distances and durations stay in
      column down a list.
    -->
    <style name="TextAppearance.StoryStep.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/bricolage_extrabold</item>
        <item name="fontFamily">@font/bricolage_extrabold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.04</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.StoryStep.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/bricolage_semibold</item>
        <item name="fontFamily">@font/bricolage_semibold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.StoryStep.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="fontFamily">@font/bricolage_bold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.StoryStep.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/bricolage</item>
        <item name="fontFamily">@font/bricolage</item>
        <item name="android:textColor">@color/story_ink_2</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.42</item>
    </style>

    <style name="TextAppearance.StoryStep.Supporting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/bricolage</item>
        <item name="fontFamily">@font/bricolage</item>
        <item name="android:textColor">@color/story_ink_2</item>
        <item name="android:textSize">@dimen/text_supporting</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!--
      Labels carry category, state and provenance. Uppercase and tracked so they read as
      annotation rather than as another line of prose competing with the place name.
    -->
    <style name="TextAppearance.StoryStep.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/bricolage_semibold</item>
        <item name="fontFamily">@font/bricolage_semibold</item>
        <item name="android:textColor">@color/story_ink_3</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.13</item>
    </style>


    <style name="TextAppearance.StoryStep.AppBar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/bricolage_semibold</item>
        <item name="fontFamily">@font/bricolage_semibold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_app_bar</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <!--
      Cards no longer lift. A hairline separates without claiming the row is a floating
      object; only the two surfaces that genuinely float - the arrival sheet and the
      session bar - use Widget.StoryStep.Card.Raised.
    -->
    <style name="Widget.StoryStep.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/story_surface</item>
    </style>

    <style name="Widget.StoryStep.Card.Raised" parent="Widget.StoryStep.Card">
        <item name="cardElevation">@dimen/floating_elevation</item>
    </style>

    <style name="Widget.StoryStep.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="android:minWidth">@dimen/minimum_touch_target</item>
        <item name="cornerRadius">@dimen/pill_corner_radius</item>
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="android:textColor">@color/story_on_photo</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">@dimen/space_24</item>
        <item name="android:paddingEnd">@dimen/space_24</item>
    </style>

    <style name="Widget.StoryStep.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="cornerRadius">@dimen/pill_corner_radius</item>
        <item name="backgroundTint">@color/story_surface</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">@dimen/space_24</item>
        <item name="android:paddingEnd">@dimen/space_24</item>
        <item name="elevation">@dimen/card_elevation</item>
    </style>

    <!-- The kind chips over the map: white pills, a coloured glyph, the wash when chosen. -->
    <style name="Widget.StoryStep.KindChip" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:checkable">true</item>
        <item name="chipBackgroundColor">@color/kind_chip_background</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:fontFamily">@font/bricolage_semibold</item>
        <item name="android:textSize">13.5sp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/pill_corner_radius</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipIconVisible">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="iconStartPadding">2dp</item>
        <item name="iconEndPadding">4dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Widget.StoryStep.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:checkable">true</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/hairline</item>
        <item name="chipCornerRadius">@dimen/pill_corner_radius</item>
        <!--
            48dp, not 36dp. A row of filter chips is several small controls sharing one parent,
            and the platform allows one TouchDelegate per parent, so the tap area cannot be
            widened without widening the chip. This makes the row visibly taller.
        -->
        <item name="android:minHeight">@dimen/minimum_touch_target</item>
        <item name="android:textSize">@dimen/text_supporting</item>
        <item name="android:fontFamily">@font/bricolage_medium</item>
    </style>

    <style name="ShapeAppearanceOverlay.StoryStep.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/image_corner_radius</item>
    </style>

    <style name="TextAppearance.StoryStep.TabLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/bricolage_medium</item>
        <item name="fontFamily">@font/bricolage_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!--
      Page vocabulary. Every screen is built from the same four parts: a tracked
      eyebrow that names what you are looking at, a display headline set in Archivo,
      prose at reading measure, and sections closed by a rule rather than boxed into
      cards. Screens differ in what they hold, not in how they are put together.
    -->
    <style name="TextAppearance.StoryStep.PageTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/bricolage_extrabold</item>
        <item name="fontFamily">@font/bricolage_extrabold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_page_title</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.08</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.StoryStep.Prose" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/bricolage</item>
        <item name="fontFamily">@font/bricolage</item>
        <item name="android:textColor">@color/story_ink_2</item>
        <item name="android:textSize">@dimen/text_prose</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.62</item>
    </style>

    <style name="Widget.StoryStep.Eyebrow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.StoryStep.Label</item>
    </style>

    <style name="Widget.StoryStep.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/hairline</item>
        <item name="android:background">@color/story_hairline</item>
    </style>

    <!-- Chrome that sits on a photograph: a square touch target on a light scrim. -->
    <style name="Widget.StoryStep.ScrimButton" parent="">
        <item name="android:layout_width">@dimen/scrim_button_size</item>
        <item name="android:layout_height">@dimen/scrim_button_size</item>
        <item name="android:background">@drawable/bg_scrim_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/story_on_photo</item>
    </style>

    <!--
      A metadata pill. Filled, fully rounded, sentence case - a row of them reads as
      facts about the place. This replaces the tracked uppercase labels, which turned
      every annotation into another line of shouting prose.
    -->
    <style name="Widget.StoryStep.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <!-- minHeight, not height: at a large font scale a fixed pill clips its own label. -->
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:background">@drawable/bg_chip_filled</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:fontFamily">@font/bricolage_medium</item>
        <item name="android:textSize">@dimen/text_chip</item>
        <item name="android:textColor">@color/story_ink_2</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawablePadding">5dp</item>
    </style>

    <!--
      The stat column. Label above, value below, unit demoted: the number is the
      content, the label names it, the unit is a footnote. Three or four of these in a
      row is how a walk is summarised.
    -->
    <style name="Widget.StoryStep.StatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/bricolage_medium</item>
        <item name="android:textSize">@dimen/text_supporting</item>
        <item name="android:textColor">@color/story_ink_2</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.StoryStep.StatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
