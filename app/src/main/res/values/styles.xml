<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Type. The display ramp is set tight and slightly negative-tracked so a place name
      reads as a name printed on a map rather than a product heading. Every style that
      can carry a figure asks for tabular numerals, so distances and durations stay in
      column down a list.
    -->
    <style name="TextAppearance.StoryStep.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.06</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.StoryStep.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.14</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.StoryStep.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.StoryStep.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="android:textColor">@color/story_ink_2</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.42</item>
    </style>

    <style name="TextAppearance.StoryStep.Supporting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="android:textColor">@color/story_ink_2</item>
        <item name="android:textSize">@dimen/text_supporting</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!--
      Labels carry category, state and provenance. Uppercase and tracked so they read as
      annotation rather than as another line of prose competing with the place name.
    -->
    <style name="TextAppearance.StoryStep.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textColor">@color/story_ink_3</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.13</item>
    </style>

    <!-- Distances, durations and counts: aligned figures, ink weight. -->
    <style name="TextAppearance.StoryStep.Metric" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_metric</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.StoryStep.AppBar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_app_bar</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <!--
      Cards no longer lift. A hairline separates without claiming the row is a floating
      object; only the two surfaces that genuinely float - the arrival sheet and the
      session bar - use Widget.StoryStep.Card.Raised.
    -->
    <style name="Widget.StoryStep.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/story_outline</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="cardBackgroundColor">@color/story_surface</item>
    </style>

    <style name="Widget.StoryStep.Card.Raised" parent="Widget.StoryStep.Card">
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.StoryStep.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="android:minWidth">@dimen/minimum_touch_target</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="android:textColor">@color/story_on_ink</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.StoryStep.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/story_outline</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.StoryStep.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:checkable">true</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/hairline</item>
        <item name="chipCornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">@dimen/text_supporting</item>
        <item name="android:fontFamily">@font/plex_sans_medium</item>
    </style>

    <style name="ShapeAppearanceOverlay.StoryStep.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/image_corner_radius</item>
    </style>

    <style name="Widget.StoryStep.BottomNavigation.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/story_ink_wash</item>
    </style>

    <!--
      Page vocabulary. Every screen is built from the same four parts: a tracked
      eyebrow that names what you are looking at, a display headline set in Archivo,
      prose at reading measure, and sections closed by a rule rather than boxed into
      cards. Screens differ in what they hold, not in how they are put together.
    -->
    <style name="TextAppearance.StoryStep.PageTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/archivo_bold</item>
        <item name="android:textColor">@color/story_ink</item>
        <item name="android:textSize">@dimen/text_page_title</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.14</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextAppearance.StoryStep.Prose" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="android:textColor">@color/story_ink_2</item>
        <item name="android:textSize">@dimen/text_prose</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.55</item>
    </style>

    <style name="Widget.StoryStep.Eyebrow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.StoryStep.Label</item>
    </style>

    <style name="Widget.StoryStep.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/hairline</item>
        <item name="android:background">@color/story_hairline</item>
    </style>

    <!-- Chrome that sits on a photograph: a square touch target on a light scrim. -->
    <style name="Widget.StoryStep.ScrimButton" parent="">
        <item name="android:layout_width">@dimen/scrim_button_size</item>
        <item name="android:layout_height">@dimen/scrim_button_size</item>
        <item name="android:background">@drawable/bg_scrim_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/story_on_photo</item>
    </style>
</resources>
