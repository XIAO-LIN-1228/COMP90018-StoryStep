<?xml version="1.0" encoding="utf-8"?>
<!--
  Daylight & Starmap.

  StoryStep is used outdoors, one-handed, in sunlight, so the walking screens are a
  high-contrast daylight surface: ink on paper. Reviewing a finished walk happens
  indoors and afterwards, so the journey surfaces use the night ground, where every
  recorded visit is a point of light.

  One accent only. story_signal means exactly one thing: "there is a story here and
  it has not been read yet" - locked places, arrival, footprint points. It is never a
  button and never a heading; primary actions are story_ink. If signal appears in a
  second role on a screen, that screen needs re-checking.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Daylight ground -->
    <color name="story_ground">#FCFBF9</color>
    <color name="story_surface">#FFFFFFFF</color>
    <color name="story_surface_sunk">#F5F2EA</color>
    <color name="story_hairline">#EAE7DF</color>
    <color name="story_outline">#E3E1DB</color>

    <!-- Ink: headings and every primary action -->
    <color name="story_ink">#14181F</color>
    <color name="story_ink_pressed">#000509</color>
    <!-- Title chrome sitting on the page header, which is now the ground itself. -->
    <color name="story_on_header">#14181F</color>
    <color name="story_on_ink">#FFFFFFFF</color>
    <color name="story_ink_wash">#F1EFE9</color>
    <color name="story_ink_2">#5A6270</color>
    <color name="story_ink_3">#8B929D</color>
    <color name="story_disabled">#A9A69D</color>

    <!-- The one accent: an unread story -->
    <!--
      Chrome that sits on a photograph, not on the page. A photograph is dark in both
      configurations, so this colour deliberately does NOT flip with the theme: tinting
      it with story_ink turned the back and save controls white-on-white in dark mode.
      The same applies to the unlock stamp, which is always amber.
    -->
    <color name="story_on_photo">#14181F</color>

    <color name="story_signal">#E0952B</color>
    <color name="story_signal_ink">#B0741A</color>
    <color name="story_signal_wash">#FBF0DC</color>

    <!-- Night ground, used by the journey surfaces -->
    <color name="story_night">#0B111C</color>
    <color name="story_night_surface">#101827</color>
    <color name="story_night_line">#182335</color>
    <color name="story_glow">#F0B44E</color>

    <color name="story_success">#1F6F52</color>
    <color name="story_error_wash">#F7E4E0</color>
    <color name="story_error">#B23A2B</color>

    <!-- Route sketch and the prototype map surface, retuned to the daylight neutrals -->
    <color name="map_land">#EFEDE6</color>
    <color name="map_park">#E2E7DA</color>
    <color name="map_water">#DDE6EC</color>
    <color name="map_road">#FCFBF9</color>
    <color name="map_location">#14181F</color>
</resources>
