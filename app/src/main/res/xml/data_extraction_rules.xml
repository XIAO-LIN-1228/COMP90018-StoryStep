<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <cloud-backup>
        <!-- Exclude all Room-managed project data from cloud backup. -->
        <exclude
            domain="database"
            path="." />

        <!-- Exclude private journey photographs from cloud backup. -->
        <exclude
            domain="file"
            path="journeys/" />
    </cloud-backup>

    <device-transfer>
        <!-- Do not transfer session, history, saved or cached database data. -->
        <exclude
            domain="database"
            path="." />

        <!-- Do not transfer private journey photographs. -->
        <exclude
            domain="file"
            path="journeys/" />
    </device-transfer>

</data-extraction-rules>