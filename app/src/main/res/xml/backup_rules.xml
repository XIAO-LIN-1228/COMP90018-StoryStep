<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>

    <!--
        Session, history, saved-attraction and cached remote data share the
        Room database. Exclude the complete database domain so user activity
        data is not copied into cloud backups.
    -->
    <exclude
        domain="database"
        path="." />

    <!-- Journey photographs are private user-generated session artifacts. -->
    <exclude
        domain="file"
        path="journeys/" />

</full-backup-content>