<?xml version="1.0" encoding="utf-8"?>
<!--
  The primary action wears the brand colour. Under the Komoot-derived rules the brand
  colour marks identity, the active state and the one action that matters on a screen;
  ink is for reading, not for pressing.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled recedes into the paper rather than becoming a second grey slab. -->
    <item android:state_enabled="false" android:color="@color/story_disabled" />
    <item android:state_pressed="true" android:color="@color/story_signal_ink" />
    <item android:color="@color/story_signal" />
</selector>
