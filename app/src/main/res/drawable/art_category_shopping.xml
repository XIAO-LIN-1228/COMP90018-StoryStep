        android:fillAlpha="0.16"
        android:fillColor="@color/kind_shopping"
        android:pathData="M160,44a56,56 0,1 1,0 112a56,56 0,1 1,0 -112z" />
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="130"
        android:translateY="70">
