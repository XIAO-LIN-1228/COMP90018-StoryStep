<?xml version="1.0" encoding="utf-8"?>
<!--
  A metadata pill: category, distance, a count. Filled and fully rounded so a row of
  them reads as data about the place rather than as more lines of prose.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/story_chip" />
    <corners android:radius="@dimen/pill_corner_radius" />
</shape>
