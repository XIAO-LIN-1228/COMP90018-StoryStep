<?xml version="1.0" encoding="utf-8"?>
<!-- The add-photo tile: a dashed outline the size of a thumbnail. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/story_surface_sunk" />
    <stroke
        android:width="1.5dp"
        android:color="@color/story_outline"
        android:dashWidth="5dp"
        android:dashGap="3dp" />
    <corners android:radius="12dp" />
</shape>
