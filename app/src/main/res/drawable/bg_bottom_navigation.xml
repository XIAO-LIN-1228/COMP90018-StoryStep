<?xml version="1.0" encoding="utf-8"?>
<!--
    The tab bar: a rounded rectangle floating clear of the page, not a capsule. Frosted rather
    than solid, so the foot of the page shows faintly through it; a bright hairline along the
    edge reads as the glass catching the light.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/story_glass" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/story_glass_edge" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
