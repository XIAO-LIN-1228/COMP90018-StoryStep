<?xml version="1.0" encoding="utf-8"?>
<!--
  The page header is the ground, closed by a hairline. The previous navy gradient band
  put a dark slab at the top of every daylight screen and forced its title chrome to
  white; the title now sits in ink on the same paper as the content beneath it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/story_hairline" />
        </shape>
    </item>
    <item android:bottom="@dimen/hairline">
        <shape android:shape="rectangle">
            <solid android:color="@color/story_ground" />
        </shape>
    </item>
</layer-list>
