<?xml version="1.0" encoding="utf-8"?>
<!--
    The "there is room for more here" control: a dashed pill on the paper rather than a solid
    button, so it reads as an empty slot waiting to be filled instead of a second action
    competing with Start.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/story_signal_wash" />
            <stroke
                android:width="1.5dp"
                android:color="@color/story_signal"
                android:dashGap="4dp"
                android:dashWidth="7dp" />
            <corners android:radius="@dimen/pill_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="@color/story_outline"
                android:dashGap="4dp"
                android:dashWidth="7dp" />
            <corners android:radius="@dimen/pill_corner_radius" />
        </shape>
    </item>
</selector>
