<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-bleed photographs carry chrome at both ends - the back control at the top, the
  unlock stamp at the bottom - so the scrim darkens both and leaves the middle of the
  picture alone.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#0014181F"
        android:endColor="#8A14181F"
        android:startColor="#7A14181F" />
</shape>
